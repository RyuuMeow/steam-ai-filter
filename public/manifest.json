{
  "manifest_version": 3,
  "name": "Steam AI Filter",
  "version": "0.7.0",
  "description": "動態查詢 Steam 遊戲的 AI 揭露並保存在本機，依等級標示、遮蔽或剔除遊戲。",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage", "alarms"],
  "host_permissions": ["https://store.steampowered.com/*"],
  "background": {"service_worker": "background.js"},
  "action": {
    "default_title": "Steam AI Filter",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [{
    "matches": ["https://store.steampowered.com/*"],
    "js": ["lookup.js", "disclosure-keywords.js", "disclosure.js", "core.js", "mask.js", "layout.js", "content.js"],
    "css": ["content.css"],
    "run_at": "document_idle"
  }]
}
