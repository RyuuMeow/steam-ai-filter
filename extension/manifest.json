{
  "manifest_version": 3,
  "name": "Steam AI Filter",
  "version": "0.10.2",
  "description": "__MSG_extensionDescription__",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://store.steampowered.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Steam AI Filter",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://store.steampowered.com/*"
      ],
      "js": [
        "i18n.js",
        "lookup.js",
        "disclosure-keywords.js",
        "disclosure.js",
        "core.js",
        "mask.js",
        "layout.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "default_locale": "en",
  "web_accessible_resources": [
    {
      "resources": [
        "icons/ai.svg",
        "icons/art.svg",
        "icons/music.svg",
        "icons/voice.svg",
        "icons/text.svg",
        "icons/translation.svg",
        "icons/code.svg",
        "icons/unknown.svg",
        "icons/check.svg",
        "icons/eye.svg"
      ],
      "matches": [
        "https://store.steampowered.com/*"
      ]
    }
  ]
}
