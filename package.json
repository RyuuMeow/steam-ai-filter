{
  "name": "steam-ai-filter",
  "version": "0.10.0",
  "private": true,
  "license": "MIT",
  "description": "Chrome extension to hide or mark Steam games with disclosed AI-generated content.",
  "keywords": [
    "steam",
    "steam-store",
    "chrome-extension",
    "ai-generated-content",
    "ai-disclosure",
    "content-filter"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RyuuMeow/steam-ai-filter.git"
  },
  "homepage": "https://github.com/RyuuMeow/steam-ai-filter",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc && node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test tests/*.test.cjs",
    "dev": "node scripts/serve.mjs",
    "check": "npm run typecheck && npm test",
    "package": "npm run build && node scripts/package.mjs",
    "package:check": "node scripts/package.mjs --check",
    "package:rar": "npm run build && npm run package:check && node scripts/package-rar.mjs",
    "release:check": "node scripts/release-info.mjs",
    "preview:package": "npm run build && node scripts/package-preview.mjs",
    "test:browser": "npm run build && node scripts/test-browser.mjs"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.5",
    "typescript": "^5.9.3"
  }
}
