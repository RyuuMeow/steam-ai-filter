{
  "name": "steam-ai-filter",
  "version": "0.7.1",
  "private": true,
  "description": "Chrome extension for filtering Steam store games by AI disclosure.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc && node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test tests/*.test.cjs",
    "dev": "node scripts/serve.mjs",
    "check": "npm run typecheck && npm test",
    "package": "npm run build && node scripts/package.mjs",
    "package:check": "node scripts/package.mjs --check",
    "package:rar": "npm run build && npm run package:check && node scripts/package-rar.mjs",
    "release:check": "node scripts/release-info.mjs",
    "preview:package": "npm run build && node scripts/package-preview.mjs"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.5",
    "typescript": "^5.9.3"
  }
}
